        "srcUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "linkUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "inlineMedia": {
          "type": "object",
          "properties": {
            "mime": {
              "type": "string"
            },
            "dataBase64": {
              "type": "string",
              "maxLength": 11184812
            }
          },
          "required": ["mime", "dataBase64"]
        },
        "upload": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
