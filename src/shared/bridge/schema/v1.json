        },
        "re": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "type": {
          "type": "string",
          "maxLength": 64
        },
        "ts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "payload": {}
      },
      "required": ["v", "id", "type", "payload"]
    },
    "Platform": {
      "type": "string",
      "enum": ["x", "instagram", "cosmos"]
    },
    "Trigger": {
      "type": "string",
      "enum": ["schedule", "hint", "manual", "toggle", "import"]
    },
    "SaveRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["image", "video", "link", "page", "post"]
