{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/host/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "scripts/**/*.mts",
    "vitest.config.mts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "out", "dist", ".worktrees", ".tmp"]
}
