/**
 * Native host: the Rust crate `native-host/` → `out/native-host/recolt-host`, a small executable
 * (std only, links libSystem alone, `aarch64-apple-darwin`), stripped, then signed:
 * `RECOLTOS_SIGN_IDENTITY` or ad hoc.
 *
 * - The protocol constants it needs come from `src/shared/bridge/constants.ts` (single source):
 *   they are written to `native-host/src/constants.rs` (committed, so `cargo build` works alone).
 * - `cargo build --release` runs every time (no-op when nothing changed); copying and signing only
 *   happen when the built binary or the identity changes (`out/native-host/.build-hash`), so a
 *   Developer ID build does not ask the timestamp server again for nothing.
 * - Developer ID: hardened runtime + secure timestamp, and NO entitlement (the host has no JIT).
 *   electron-builder must not re-sign it (`mac.signIgnore`): it would add the app's entitlements.
 *
 * Requires Rust (https://rustup.rs) with the `aarch64-apple-darwin` target.
 * Without `native-host/Cargo.toml`, exits cleanly.
 */
import { execFileSync, spawnSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import {
  chmodSync,
  copyFileSync,
  existsSync,
  mkdirSync,
  readFileSync,
  rmSync,
  writeFileSync,
} from 'node:fs'
import { join, resolve } from 'node:path'
import { pathToFileURL } from 'node:url'
import {
  BRIDGE_PROTOCOL_VERSION,
  CHROMIUM_EXTENSION_ORIGINS,
  FIREFOX_EXTENSION_IDS,
  HOST_PING_MS,
  MAX_FROM_EXT_BYTES,
  MAX_TO_EXT_BYTES,
} from '../src/shared/bridge/constants'

const ROOT = resolve(import.meta.dirname, '..')

export const HOST_NAME = 'recolt-host'
export const HOST_TARGET = 'aarch64-apple-darwin'

export interface BuildHostOptions {
  root?: string
  /** Output folder of the signed executable (default `out/native-host`). */
  outDir?: string
  logLevel?: 'info' | 'silent'
}

function signIdentity(): string {
  const id = (process.env.RECOLTOS_SIGN_IDENTITY ?? '').trim()
  return id === '' ? '-' : id
}

/** Rust source of `native-host/src/constants.rs` (from the TypeScript protocol constants). */
export function rustConstants(): string {
  const allowed = [...CHROMIUM_EXTENSION_ORIGINS, ...FIREFOX_EXTENSION_IDS]
  return [
    '// Generated by `scripts/build-host.mts` from `src/shared/bridge/constants.ts`: do not edit.',
    '',
    `pub const BRIDGE_PROTOCOL_VERSION: u32 = ${BRIDGE_PROTOCOL_VERSION};`,
    '/// Chromium origins (`allowed_origins`) then Firefox IDs (`allowed_extensions`).',
    'pub const DEFAULT_ALLOWED: &[&str] = &[',
    ...allowed.map((a) => `    ${JSON.stringify(a)},`),
    '];',
    '/// extension → host: browser limit.',
    `pub const MAX_FROM_EXT_BYTES: usize = ${MAX_FROM_EXT_BYTES};`,
    '/// host → extension: beyond this, the browser closes the port.',
    `pub const MAX_TO_EXT_BYTES: usize = ${MAX_TO_EXT_BYTES};`,
    '/// Interval of the host `ping` (keeps the service worker awake).',
    `pub const HOST_PING_MS: u64 = ${HOST_PING_MS};`,
    '',
  ].join('\n')
}

/**
 * Cargo to run: `CARGO` if set, otherwise the rustup toolchain of `native-host/rust-toolchain.toml`
 * (with its own `rustc`, so a broken or older `cargo` earlier in the PATH, e.g. Homebrew's, is not
 * used), otherwise `cargo` from the PATH. `null` when Rust is not installed.
 */
export function resolveCargo(crate: string): { cargo: string; env: NodeJS.ProcessEnv } | null {
  const which = (tool: string) => {
    const r = spawnSync('rustup', ['which', tool], { cwd: crate, encoding: 'utf8' })
    return r.status === 0 ? r.stdout.trim() : null
  }
  const explicit = process.env.CARGO?.trim()
  if (explicit) return { cargo: explicit, env: {} }
  const cargo = which('cargo')
  const rustc = which('rustc')
  if (cargo && rustc) return { cargo, env: { RUSTC: rustc } }
  const r = spawnSync('cargo', ['--version'], { cwd: crate, stdio: 'ignore' })
  return r.status === 0 ? { cargo: 'cargo', env: {} } : null
}

export function buildHost(options: BuildHostOptions = {}): string | null {
  const root = options.root ?? ROOT
  const crate = resolve(root, 'native-host')
  if (!existsSync(join(crate, 'Cargo.toml'))) return null
  const quiet = options.logLevel === 'silent'

  const constants = join(crate, 'src', 'constants.rs')
  const source = rustConstants()
  if (!existsSync(constants) || readFileSync(constants, 'utf8') !== source) {
    writeFileSync(constants, source)
  }

  const toolchain = resolveCargo(crate)
  if (!toolchain) {
    throw new Error(
      'build:host needs Rust: install it with rustup (https://rustup.rs), then ' +
        `\`rustup target add ${HOST_TARGET}\`.`,
    )
  }
  const cargo = spawnSync(
    toolchain.cargo,
    ['build', '--release', '--locked', '--target', HOST_TARGET, ...(quiet ? ['--quiet'] : [])],
    {
      cwd: crate,
      env: { ...process.env, ...toolchain.env },
      stdio: quiet ? ['ignore', 'pipe', 'pipe'] : 'inherit',
      encoding: 'utf8',
    },
  )
  if (cargo.status !== 0) {
    throw new Error(`cargo build failed (code ${cargo.status})\n${cargo.stderr ?? ''}`)
  }
  const built = join(crate, 'target', HOST_TARGET, 'release', HOST_NAME)

  const outDir = options.outDir ?? resolve(root, 'out/native-host')
  const exe = join(outDir, HOST_NAME)
  const identity = signIdentity()
  const hardenedRuntime = identity.startsWith('Developer ID Application:')
  const hash = createHash('sha256').update(readFileSync(built)).update(identity).digest('hex')
  const hashFile = join(outDir, '.build-hash')
  if (existsSync(exe) && existsSync(hashFile) && readFileSync(hashFile, 'utf8') === hash) return exe

  mkdirSync(outDir, { recursive: true })
  rmSync(exe, { force: true })
  copyFileSync(built, exe)
  chmodSync(exe, 0o755)
  if (process.platform === 'darwin') {
    execFileSync('/usr/bin/strip', [exe], { stdio: 'pipe' })
    const signArgs = ['--sign', identity, '--force', '--identifier', 'com.recoltos.host']
    if (hardenedRuntime) signArgs.push('--options', 'runtime', '--timestamp')
    execFileSync('codesign', [...signArgs, exe], { stdio: 'pipe' })
  }
  // Leftovers of the former Node SEA host build.
  rmSync(join(outDir, '.sea-work'), { recursive: true, force: true })
  rmSync(resolve(root, 'out/host'), { recursive: true, force: true })
  writeFileSync(hashFile, hash)
  return exe
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  try {
    const out = buildHost()
    console.log(
      out
        ? `build:host: ${out}`
        : 'build:host: native-host/Cargo.toml is missing, nothing to build',
    )
  } catch (err: unknown) {
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
  }
}
