{
  "name": "recoltos",
  "productName": "RecoltOS",
  "version": "0.1.1",
  "private": true,
  "description": "RecoltOS : bibliothèque visuelle locale pour macOS",
  "author": "Younes Khelifi",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "tsx --tsconfig tsconfig.node.json scripts/make-fixtures.mts --out \"$PWD/.tmp/demo-userdata\" --if-missing && RECOLTOS_USER_DATA=\"$PWD/.tmp/demo-userdata\" electron-vite dev",
    "build": "run-s build:app build:host build:ext",
    "build:app": "electron-vite build",
    "build:host": "tsx --tsconfig tsconfig.node.json scripts/build-host.mts",
    "build:ext": "tsx --tsconfig tsconfig.node.json scripts/build-ext.mts",
    "lint:ext": "web-ext lint --source-dir dist-extension/firefox",
    "sign:firefox": "tsx --tsconfig tsconfig.node.json scripts/sign-firefox.mts",
    "gen:bridge-schema": "tsx --tsconfig tsconfig.node.json scripts/gen-bridge-schema.mts",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pkg": "tsx --tsconfig tsconfig.node.json scripts/check-package.mts",
    "check:env": "tsx --tsconfig tsconfig.node.json scripts/doctor.mts",
    "rebuild:native": "electron-builder install-app-deps",
    "smoke:native": "electron scripts/smoke-native.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project renderer",
    "test:cov": "vitest run --project unit --project renderer --coverage",
    "test:real": "vitest run --project real",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:perf": "playwright test --project=perf",
    "test:packaged": "playwright test --project=packaged",
    "test:ext": "playwright test --project=ext-smoke",
    "test:ext:firefox": "tsx --tsconfig tsconfig.node.json scripts/ext-firefox-smoke.mts",
    "bench:color": "tsx --tsconfig tsconfig.node.json scripts/bench-color.mts",
    "shots": "tsx --tsconfig tsconfig.node.json scripts/visual/shots.mts",
    "fixtures": "tsx --tsconfig tsconfig.node.json scripts/make-fixtures.mts",
    "icon": "tsx --tsconfig tsconfig.node.json scripts/make-icon.mts && sh scripts/make-icns.sh",
    "pack": "pnpm run build && electron-builder --config electron-builder.config.cjs --mac dir --arm64",
    "check:dist": "tsx --tsconfig tsconfig.node.json scripts/check-dist.mts",
    "check:dist:test": "tsx --tsconfig tsconfig.node.json scripts/check-dist.mts --profile test --app dist/test/mac-arm64/RecoltOS.app",
    "dist": "run-s verify:fast pack check:dist",
    "dist:dmg": "pnpm run build && electron-builder --config electron-builder.config.cjs --mac dmg --arm64",
    "dist:test": "RECOLTOS_DIST_PROFILE=test run-s pack check:dist:test",
    "app:install": "sh scripts/install-local.sh",
    "guard": "sh scripts/guard-data.sh",
    "gate:ui": "playwright test --project=e2e --project=visual",
    "verify:fast": "run-s format:check lint typecheck check:pkg test:unit",
    "verify": "run-s verify:fast gate:ui guard",
    "verify:full": "run-s verify test:real dist test:packaged test:perf",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{js,cjs,mjs,json,css,html,yaml,yml}": "prettier --check"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "9.39.5",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/chrome": "0.3.0",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "3.3.1",
    "@use-gesture/react": "10.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "culori": "4.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.7",
    "electron-log": "5.4.4",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "file-type": "22.1.1",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "immer": "11.1.18",
    "lint-staged": "17.6.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "npm-run-all2": "9.0.3",
    "p-queue": "9.3.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.9.9",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-git-hooks": "2.14.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "web-ext": "10.7.0",
    "yazl": "3.3.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
